+/// Not upstream: benchmarks/cluster in apache/datafusion-ballista adds this so the
+/// benchmark can give each pod the memory limit Ballista's executors get.
+/// MEMORY_POOL_BYTES sizes a FairSpillPool shared by everything the process runs,
+/// and SPILL_DIR is where operators that go past their share spill to. Unset, the
+/// runtime is upstream's: no memory limit, spills in the OS temp directory.
+fn runtime_env_from_env() -> Result<Arc<RuntimeEnv>, Box<dyn Error>> {
+    let mut builder = RuntimeEnvBuilder::new();
+    match std::env::var("MEMORY_POOL_BYTES").ok().filter(|v| !v.is_empty()) {
+        Some(bytes) => {
+            let bytes: usize = bytes.parse()?;
+            info!("Memory pool: FairSpillPool of {bytes} bytes");
+            builder = builder.with_memory_pool(Arc::new(FairSpillPool::new(bytes)));
+        }
+        None => info!("Memory pool: unbounded"),
+    }
+    if let Some(dir) = std::env::var("SPILL_DIR").ok().filter(|v| !v.is_empty()) {
+        info!("Spill directory: {dir}");
+        builder = builder.with_temp_file_path(dir);
+    }
+    Ok(builder.build_arc()?)
+}
